{
  "compilerOptions": {
    "module": "nodenext",
    "allowJs": true,
    "checkJs": true,
    "lib": ["esnext", "dom"],
    "types": ["node"],
    "strict": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "noEmit": true,
    "skipLibCheck": false
  },
  "include": ["index.d.ts", "tests/**/*.ts"]
}
